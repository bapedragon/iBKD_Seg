  },
  "runtime": {
    "feature_batch_size": 32,
    "num_workers": 0,
    "device": "auto"
  },
  "smoke": {
    "methods": ["Ours"],
    "samples": {
      "train": 16,
      "validation": 16,
      "test": 16
    },
    "epochs": 2,
    "learning_rates": [0.03],
    "seeds": [1]
  }
