{
  "schema_version": 1,
  "protocol_id": "flowers102_phase1a_frozen_spatial_probe_v1",
  "status": "locked_before_results_2026-09-04",
  "interpretation": "pseudo_mask_pipeline_diagnostic_only",
  "dataset": {
    "name": "flowers102",
    "splits": {
      "train": "official_train_1020",
      "validation": "official_validation_1020",
      "test": "official_test_6149"
    },
    "mask": {
      "conversion": "least_squares_alpha_from_blue_screen_composite",
      "alpha_threshold": 0.5,
      "posthoc_exclusion": "none",
      "postprocessing": "none"
    },
    "input": {
      "size": 224,
      "resize": "direct_square",
      "image_interpolation": "bilinear",
      "mask_interpolation": "nearest",
      "antialias": true,
