      "normalization_std": [0.229, 0.224, 0.225],
      "random_augmentation": false
    }
  },
  "encoder": {
    "architecture": "deit_tiny_patch16_224",
    "checkpoint_manifest": "manifests/checkpoints.json",
    "strict_load": true,
    "frozen": true,
    "eval_mode": true,
    "feature": {
      "block_index": 11,
      "norm": false,
      "output_format": "NCHW",
      "channels": 192,
      "height": 14,
      "width": 14,
      "cache_dtype": "float32"
    }
  },
  "probe": {
    "architecture": "Conv2d(192,2,1,bias=True)",
    "parameter_count": 386,
    "initialization": {
      "weight": "normal",
      "weight_std": 0.01,
      "bias": 0.0
    },
    "target": {
      "grid_height": 14,
      "grid_width": 14,
